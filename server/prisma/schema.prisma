generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id          String   @id @default(uuid())
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  // 진입 시 선택한 장소 (장소별 경품 추첨 대상)
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  consentedAt DateTime?

  // 입장 사진 (홈서버 로컬 저장)
  photoPath   String?

  // 검사 응답 12개 — SQLite array 미지원으로 JSON string 저장
  responses   String?
  lastAnswerAt DateTime?

  // 결과 — enum 대신 string ("investigator"|"helper"|"leader"|"innovator")
  resultType  String?
  // 유형별 점수 — JSON string { investigator: 12, helper: 9, leader: 8, innovator: 7 }
  scores      String?

  // 캐릭터 (통이미지 방식 — accessory 단일 카테고리)
  gender      String?
  hair        Int?
  accessory   String?  // "none"|"cap"|"beanie"|"band"(F)|"bucket"(M)|"glasses"

  // 봉사자증
  nickname    String?
  pledge      String?
  cardNo      String?  @unique
  issuedAt    DateTime?

  // 대회 안내·홍보용 (2026-05-13 추가, 모두 필수)
  realName    String?  // 본명 (최대 20자)
  contact     String?  // 연락처 (010-XXXX-XXXX)
  birthDate   String?  // 생년월일 (YYYY-MM-DD)

  // 뽑기
  prizeDrawn  Boolean  @default(false)
  prizeRank   Int?
  // 추첨된 경품 (장소별 Prize). 경품이 삭제돼도 기록이 남도록 이름은 스냅샷으로 보관
  prizeId     Int?
  prizeName   String?
  drawnAt     DateTime?

  @@index([createdAt])
  @@index([resultType])
  @@index([locationId])
}

// 부스 운영 장소 — 장소마다 경품 풀이 따로 존재
model Location {
  id        String    @id @default(uuid())
  name      String
  // 진입 화면 노출 여부 (소진·미운영 장소는 숨김)
  active    Boolean   @default(true)
  // 진입 화면 정렬 순서
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  prizes    Prize[]
  sessions  Session[]

  @@index([active, sortOrder])
}

model Prize {
  id         Int      @id @default(autoincrement())
  // 소속 장소 — 장소 삭제 시 경품도 함께 삭제
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rank       Int      @default(0)
  name       String
  total      Int
  remaining  Int

  @@index([locationId])
}

model EventLog {
  id        Int      @id @default(autoincrement())
  sessionId String?
  type      String
  // JSON string — SQLite Json? 미지원
  meta      String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}
